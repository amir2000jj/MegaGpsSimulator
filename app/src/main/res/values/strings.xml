    <!-- setup dialog -->
    <string name="setup_title">Mock location setup</string>
    <string name="setup_steps">1. Enable Developer options: Settings > About phone > tap the OS / MIUI version (or Build number) 7 times.\n2. Open Developer options > “Select mock location app” and choose Mega GPS Simulator.\n3. Allow location (and notification) permission when asked.\n4. Turn Location (GPS) on.\n5. Come back here and start the simulation.</string>
