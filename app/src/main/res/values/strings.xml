    <!-- about -->
    <string name="about_desc">Simulate a GPS location or movement along a route using Android\'s official mock location feature. No root required.</string>
    <string name="about_limits_title">Limitations</string>
    <string name="about_limits">Mock location is a development / testing mechanism. Apps can detect mock locations and may also use Wi-Fi, cellular, IP or sensor signals, so this app cannot hide your real location from every app. The simulation stops if you force-stop the app or Android ends the service, and it never restarts by itself.</string>
    <string name="about_privacy_title">Privacy</string>
    <string name="about_privacy">Your real location is only read when you tap “Real location” and never leaves the device. Place search sends only the text you type (OpenStreetMap Nominatim). Online routing sends only the waypoints you placed. Map tiles are downloaded from OpenStreetMap.</string>
    <string name="about_osm">Map data © OpenStreetMap contributors.</string>
